{
  "_comment": "全局配置。用 JSON 而不是 YAML，是为了维持核心链路零第三方依赖 —— pyyaml 不在标准库里。",

  "db_path": "data/index.db",

  "embedding": {
    "kind": "hashing",
    "dim": 512
  },

  "llm": {
    "kind": "mock",
    "model": "qwen2.5:7b-instruct",
    "base_url": "http://localhost:11434"
  },

  "retrieval": {
    "top_k": 5,
    "rrf_k": 60,
    "weights": {
      "vector": 0.5,
      "bm25": 0.5
    },
    "rerank": true
  },

  "guards": {
    "input": {
      "sanitize_at": 0.35,
      "block_at": 0.7
    },
    "output": {
      "min_grounding": 0.25,
      "strict": false
    }
  },

  "docs": [
    { "doc_id": "acme-handbook",     "path": "data/docs/acme_handbook.md",               "title": "员工手册",                 "tenant_id": "acme", "acl_group": "public",   "sensitivity": 0 },
    { "doc_id": "acme-leave",        "path": "data/docs/acme_leave_policy.md",           "title": "考勤与休假管理制度",       "tenant_id": "acme", "acl_group": "public",   "sensitivity": 0 },
    { "doc_id": "acme-conduct",      "path": "data/docs/acme_workplace_conduct.md",      "title": "办公场所与行为规范",       "tenant_id": "acme", "acl_group": "public",   "sensitivity": 0 },
    { "doc_id": "acme-se-baseline",  "path": "data/docs/acme_info_security_baseline.md", "title": "信息安全基线要求",         "tenant_id": "acme", "acl_group": "public",   "sensitivity": 1 },
    { "doc_id": "acme-onboarding",   "path": "data/docs/acme_onboarding_guide.md",       "title": "新人入职指引",             "tenant_id": "acme", "acl_group": "public",   "sensitivity": 0 },
